/* === Root === */
.pause-root {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

/* === Pause Button === */
.pause-btn {
    position: absolute;
    top: 20px;
    right: 20px; /* Aligned to right edge */
    width: 70px; /* Increased for better touch target */
    height: 70px;
    border-radius: 50%;
    font-size: 40px; /* Increased for mobile */
    color: #00ffff;
    background-color: rgba(0, 255, 255, 0.15);
    border-color: #00ffff;
    border-width: 3px;
    unity-text-align: middle-center;
    text-shadow: 0 0 12px #00ffff, 0 0 24px #00cccc;
    transition: all 0.2s ease-in-out;
    pointer-events: auto;
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
}

.pause-btn:hover {
    background-color: rgba(0, 255, 255, 0.3);
    transform: scale(1.05);
    box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
}

.pause-btn:active {
    transform: scale(0.95);
}

/* === Panel Background === */
.pause-panel {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    pointer-events: auto;
}

/* === Overlay (dark background) === */
.pause-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
}

/* === Content Container === */
.pause-content {
    width: 90%;
    max-width: 450px;
    background-color: rgba(0, 10, 20, 0.95);
    border: 3px solid #00ffff;
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 20px;
    padding: 40px 30px;
    text-align: center;
    box-shadow: 0 0 40px rgba(0, 255, 255, 0.5);
}

/* === Title === */
.pause-title {
    font-size: 56px; /* Increased for mobile */
    color: #00ffff;
    unity-font-style: bold;
    text-shadow: 
        0 0 15px #00ffff,
        0 0 30px #00cccc,
        0 0 45px #009999;
    margin-bottom: 10px;
}

/* === Subtitle === */
.pause-subtitle {
    font-size: 18px;
    color: rgba(0, 255, 255, 0.7);
    text-shadow: 0 0 8px #00ffff;
    margin-bottom: 20px;
}

/* === Buttons Container === */
.pause-buttons {
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 15px;
}

/* === Buttons === */
.pause-option {
    width: 100%;
    max-width: 320px;
    height: 65px; /* Increased for mobile touch */
    font-size: 28px; /* Increased for mobile readability */
    color: #00ffff;
    border-color: #00ffff;
    background-color: rgba(0, 255, 255, 0.08);
    border-width: 2px;
    border-radius: 12px;
    transition-property: all;
    transition-duration: 0.2s;
    text-shadow: 0 0 8px #00ffff;
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.2);
}

.pause-option:hover {
    background-color: rgba(0, 255, 255, 0.25);
    color: white;
    text-shadow: 0 0 20px #00ffff, 0 0 40px #00cccc;
    transform: scale(1.02);
    box-shadow: 0 0 25px rgba(0, 255, 255, 0.4);
}

.pause-option:active {
    transform: scale(0.98);
    background-color: rgba(0, 255, 255, 0.35);
}

/* === Primary Button (Resume) === */
.pause-primary {
    background-color: rgba(0, 255, 255, 0.15);
    border-width: 3px;
    font-size: 32px;
}

.pause-primary:hover {
    background-color: rgba(0, 255, 255, 0.35);
}

/* === Danger Button (Exit) === */
.pause-danger {
    border-color: rgba(255, 100, 100, 0.8);
    color: rgba(255, 150, 150, 0.9);
    background-color: rgba(255, 0, 0, 0.05);
}

.pause-danger:hover {
    background-color: rgba(255, 0, 0, 0.15);
    border-color: rgba(255, 100, 100, 1);
    color: rgba(255, 200, 200, 1);
}
