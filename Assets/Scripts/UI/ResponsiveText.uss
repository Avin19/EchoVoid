/* ============================================
   RESPONSIVE TEXT STYLES FOR MOBILE DEVICES
   ============================================ */

/* Base text sizes - optimized for mobile */
:root {
    --text-tiny: 14px;
    --text-small: 18px;
    --text-normal: 24px;
    --text-medium: 32px;
    --text-large: 48px;
    --text-xlarge: 64px;
    --text-huge: 80px;
}

/* === RESPONSIVE TEXT CLASSES === */

/* Tiny text (footer, hints) */
.text-tiny {
    font-size: var(--text-tiny);
}

/* Small text (descriptions, subtitles) */
.text-small {
    font-size: var(--text-small);
}

/* Normal text (body text, labels) */
.text-normal {
    font-size: var(--text-normal);
}

/* Medium text (step titles, important info) */
.text-medium {
    font-size: var(--text-medium);
}

/* Large text (section headers) */
.text-large {
    font-size: var(--text-large);
}

/* Extra large text (main titles) */
.text-xlarge {
    font-size: var(--text-xlarge);
}

/* Huge text (game title, big headers) */
.text-huge {
    font-size: var(--text-huge);
}

/* === BUTTON TEXT SIZES === */
.button-text-small {
    font-size: 20px;
}

.button-text-normal {
    font-size: 28px;
}

.button-text-large {
    font-size: 36px;
}

/* === HUD TEXT SIZES === */
.hud-label-text {
    font-size: 22px;
}

.hud-value-text {
    font-size: 28px;
}

.hud-title-text {
    font-size: 32px;
}

/* === MOBILE-SPECIFIC OVERRIDES === */
/* These will be applied when screen width is small */

@media (max-width: 800px) {
    :root {
        --text-tiny: 16px;
        --text-small: 22px;
        --text-normal: 28px;
        --text-medium: 38px;
        --text-large: 56px;
        --text-xlarge: 72px;
        --text-huge: 96px;
    }

    .button-text-small {
        font-size: 24px;
    }

    .button-text-normal {
        font-size: 32px;
    }

    .button-text-large {
        font-size: 42px;
    }

    .hud-label-text {
        font-size: 26px;
    }

    .hud-value-text {
        font-size: 34px;
    }

    .hud-title-text {
        font-size: 38px;
    }
}

/* === TABLET OVERRIDES === */
@media (min-width: 801px) and (max-width: 1200px) {
    :root {
        --text-tiny: 15px;
        --text-small: 20px;
        --text-normal: 26px;
        --text-medium: 36px;
        --text-large: 52px;
        --text-xlarge: 68px;
        --text-huge: 88px;
    }
}

/* === HIGH DPI SCREENS === */
@media (min-resolution: 2dppx) {
    :root {
        --text-tiny: 15px;
        --text-small: 20px;
        --text-normal: 26px;
        --text-medium: 36px;
        --text-large: 52px;
        --text-xlarge: 70px;
        --text-huge: 90px;
    }
}

/* === UTILITY CLASSES === */

/* Make text bold */
.text-bold {
    unity-font-style: bold;
}

/* Text with glow effect */
.text-glow {
    text-shadow: 0 0 10px #00ffff, 0 0 20px #00cccc;
}

/* Text with strong glow */
.text-glow-strong {
    text-shadow: 0 0 15px #00ffff, 0 0 30px #00cccc, 0 0 45px #009999;
}

/* Readable text (ensures minimum size) */
.text-readable {
    font-size: 24px;
    min-height: 32px;
}

/* Touch-friendly button text */
.text-touchable {
    font-size: 32px;
    min-height: 48px;
    padding: 8px 16px;
}
